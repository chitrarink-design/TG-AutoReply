# user = auto-reply from your own Telegram account (default)
# bot  = customers chat with a bot from @BotFather
MODE=user

# For MODE=user: get these at https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# For MODE=bot: token from @BotFather
BOT_TOKEN=

# Password to log in to the admin website
ADMIN_PASSWORD=change-me

# Use 0.0.0.0 when running on a server so the website is reachable from outside
HOST=127.0.0.1
PORT=8080
